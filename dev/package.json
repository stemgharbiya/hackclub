{
  "name": "dev",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "predev": "node scripts/clean-content-cache.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/clean-content-cache.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "clean:cache": "node scripts/clean-content-cache.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:schema": "wrangler d1 execute gharbiya-join-team --file=worker/schema.sql --remote --config worker/wrangler.toml",
    "worker:questions": "node scripts/generate-worker-questions.mjs",
    "worker:test": "node worker/test/validate.test.mjs && node worker/test/handler.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^6.0.2",
    "@hackclub/icons": "^0.0.15",
    "@hackclub/theme": "^0.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^5.17.1",
    "marked": "^17.0.4",
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@astrojs/react": "^4.4.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.149.0"
  }
}
