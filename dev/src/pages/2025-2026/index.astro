---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeasonArchive from '../../components/SeasonArchive.astro';
import TeamGrid from '../../components/TeamGrid.astro';
import { bySeason, getSeason } from '../../lib/seasons';
import theme from '@hackclub/theme';
import bobaGirls from '../../assets/images/boba-girls.jpeg';
import bobaBoys from '../../assets/images/boba-boys.jpeg';

const season = getSeason(5);

if (!season) {
  throw new Error('Season 5 is missing from SEASONS in src/lib/seasons.ts');
}

const seasonTeam = bySeason((await getCollection('team')).sort((a, b) => a.data.order - b.data.order), season.number);
---

<BaseLayout
  title="Season 5 (2025 – 2026) | Gharbiya STEM Hack Club"
  description="A farewell to Season 5: every workshop and event Gharbiya STEM Hack Club ran between November 2025 and July 2026."
  currentPath="/2025-2026"
>
  <!-- Hero Section -->
  <section class="card mb-12">
    <p class="text-sm font-semibold uppercase tracking-wide" style="color: var(--accent)">// {season.label.toUpperCase()} · {season.years} · CLOSED</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl" style={`background-image: ${theme.util.gx(...season.gradient)}; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;`}>The season is over. What you shipped isn't.</h1>
    <p class="mt-4 max-w-3xl text-lg text-slate-600 dark:text-slate-300">
      Twenty-fifth of November, 2025: stickers, a kickoff, and a login page with a hole in it for the red team
      to exploit. The last night of the season ended on a ping pong table at a gaming cafe.
    </p>
    <p class="mt-3 max-w-3xl text-lg text-slate-600 dark:text-slate-300">
      This page is the record of the months in between — every workshop you joined, every event you walked into,
      every project that got approved. Not a summary. A receipt.
    </p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a class="btn cta justify-center sm:justify-start" href="#what-we-did">Read the whole season</a>
      <a class="btn outline justify-center sm:justify-start" href="#the-part-nobody-wears">Skip to the goodbye</a>
    </div>
  </section>

  <!-- The Boba Workshop Photos -->
  <section class="mb-12">
    <h2 class="mb-6 text-3xl font-bold text-slate-900 dark:text-white">One workshop. Two tables.</h2>
    <p class="mb-6 max-w-3xl text-slate-600 dark:text-slate-300">
      The boba workshop was the loudest night of the season. Beginners, one afternoon, HTML and CSS, a personal
      site pushed to GitHub, and $5 of boba waiting for everyone who finished. These are the two groups that filled
      the room.
    </p>
    <div class="grid gap-6 sm:grid-cols-2">
      <figure class="card">
        <Image
          src={bobaGirls}
          alt="The girls' group working through the boba workshop together"
          class="aspect-[4/3] w-full rounded-xl object-cover"
          loading="lazy"
        />
        <figcaption class="mt-4">
          <h3 class="text-xl font-semibold text-slate-900 dark:text-white">The girls' table</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
            One afternoon, a blank editor, and a brief most of them had never seen before: a personal site, five
            real features, a live link. They shipped it and collected $5 of boba for the trouble.
          </p>
        </figcaption>
      </figure>
      <figure class="card">
        <Image
          src={bobaBoys}
          alt="The boys' group working through the boba workshop together"
          class="aspect-[4/3] w-full rounded-xl object-cover"
          loading="lazy"
        />
        <figcaption class="mt-4">
          <h3 class="text-xl font-semibold text-slate-900 dark:text-white">The boys' table</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
            Same brief, same deadline, same $5 waiting at the end. This is the other half of the room that turned
            36 approved submissions out of a single workshop session.
          </p>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Shared season data, stats, and timeline -->
  <SeasonArchive season={season} />


  <!-- The Team That Ran Season 5 -->
  {
    seasonTeam.length > 0 && (
      <section class="mb-12">
        <div class="mb-6">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">// THE SEASON 5 TEAM</p>
          <h2 class="mt-2 text-3xl font-bold text-slate-900 dark:text-white">Who ran this season</h2>
          <p class="mt-2 max-w-3xl text-slate-600 dark:text-slate-300">
            This is the team as it stood for Season 5. They have since handed over to the Season 6 team, and their
            cards stay here with the rest of the season's record.
          </p>
        </div>
        <TeamGrid team={seasonTeam} variant="former" />
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn outline" href="/team#former-members">All former members</a>
          <a class="btn cta" href="/2026-2027">Meet the Season 6 team</a>
        </div>
      </section>
    )
  }

  <!-- The Farewell -->
  <section class="mb-12" id="the-part-nobody-wears">
    <h2 class="mb-6 text-3xl font-bold text-slate-900 dark:text-white">The part nobody puts on the badge</h2>
    <div class="card gradient-red-orange">
      <p class="text-lg text-slate-700 dark:text-slate-200">
        Every season ends the same way. The forms close, the group chat goes quiet, and a folder full of websites
        sits there unopened until somebody eventually says <em>remember when?</em>
      </p>
      <p class="mt-4 text-lg text-slate-700 dark:text-slate-200">So we are saying it now, while it still counts:</p>
      <ul class="mt-4 space-y-3 text-slate-700 dark:text-slate-200">
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-xl leading-6">🥤</span>
          <span>You learned HTML and CSS in a room with no teacher — just a leader, a link, and a deadline.</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-xl leading-6">🚫🎨</span>
          <span>You were told no CSS was allowed, and you built something beautiful out of text anyway.</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-xl leading-6">🤖</span>
          <span>You let an AI write the first draft, then opened the file and made it yours.</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-xl leading-6">🛡️</span>
          <span>You sat through a red team lecture knowing that by the end of the season you would defend the thing instead.</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="text-xl leading-6">🏓</span>
          <span>You played ping pong at a gaming cafe and let that count as a closing ceremony.</span>
        </li>
      </ul>
      <p class="mt-6 text-lg font-semibold text-slate-900 dark:text-white">
        That is Season 5. Not the Level 3 badge — the habit of showing up.
      </p>
      <p class="mt-3 text-slate-700 dark:text-slate-200">
        Season 6 started from an empty page. The people who came back twice this season are the only reason there
        was a Season 6 at all.
      </p>
    </div>
  </section>

  <!-- Season 6 CTA -->
  <section>
    <div class="card text-center gradient-yellow-red">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white sm:text-3xl">Season 6 is already running</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
        This page stays exactly as it is. Season 6 has its own page, its own calendar, and its own numbers — the two
        never mix.
      </p>
      <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a class="btn cta justify-center sm:justify-start" href="/2026-2027">Go to Season 6</a>
        <a class="btn outline justify-center sm:justify-start" href="/seasons">Browse all seasons</a>
      </div>
    </div>
  </section>
</BaseLayout>
