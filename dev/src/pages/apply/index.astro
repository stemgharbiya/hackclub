---
import BaseLayout from '../../layouts/BaseLayout.astro';
import theme from '@hackclub/theme';
---

<BaseLayout
  title="Apply | Gharbiya STEM Hack Club"
  description="Apply to join Gharbiya STEM Hack Club activities."
  currentPath="/apply"
>
  <section class="card mb-8">
    <p class="text-sm font-semibold uppercase tracking-wide" style="color: var(--accent)">// APPLY</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl" style={`background-image: ${theme.util.gx('orange', 'red')}; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;`}>
      Apply to join.
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-slate-600 dark:text-slate-300">
      Fill out the form below to apply for upcoming club activities.
    </p>
  </section>

  <section>
    <div
      style="width:100%;height:700px;"
      data-zite-id="sfezxws3j8"
      data-zite-embed-type="standard"
      data-zite-inherit-parameters
    ></div>
    <script is:inline src="https://server.zite.com/embed/v2-zite/"></script>
  </section>
</BaseLayout>
