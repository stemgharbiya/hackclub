---
// src/pages/apply.astro
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Application | Gharbiyahc</title>
</head>
<body class="m-0 p-0 bg-white">

  <!-- Main view wrapper for the Zite Form -->
  <div class="w-screen h-screen">
    
    <!-- Zite Target Anchor Box -->
    <div 
      style="width:100%; height:100vh;" 
      data-zite-id="sfezxws3j8" 
      data-zite-embed-type="standard" 
      data-zite-inherit-parameters
    ></div>

    <!-- The inline directive tells Astro not to process or bundle this script, 
         allowing the Zite engine to execute natively in the browser window -->
    <script is:inline src="https://server.zite.com/embed/v2-zite/"></script>

  </div>

</body>
</html>
