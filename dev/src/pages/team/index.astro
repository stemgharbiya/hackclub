---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeamGrid from '../../components/TeamGrid.astro';
import { getArchivedSeasons, getCurrentSeason, bySeason } from '../../lib/seasons';
import theme from '@hackclub/theme';

const currentSeason = getCurrentSeason();
const archivedSeasons = getArchivedSeasons();

const allMembers = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);

// Only the live season is "the team". Past teams are archived, not deleted.
const team = bySeason(allMembers, currentSeason.number);

// Anything not in the current season or an archived one is grouped separately,
// so a member is never silently dropped from the page.
const groupedIds = new Set([
  ...team.map((m) => m.id),
  ...archivedSeasons.flatMap((season) => bySeason(allMembers, season.number).map((m) => m.id))
]);
const ungrouped = allMembers.filter((member) => !groupedIds.has(member.id));

const showLeaderApplications = import.meta.env.PUBLIC_SHOW_LEADER_APPLICATIONS === 'true';
---

<BaseLayout
  title="Team | Gharbiya STEM Hack Club"
  description="Meet the leadership and committee members of Gharbiya STEM Hack Club."
  currentPath="/team"
>
  <!-- Hero Section -->
  <section class="card mb-12">
    <p class="text-sm font-semibold uppercase tracking-wide" style="color: var(--color-cyan)">// {currentSeason.label.toUpperCase()} · {currentSeason.years}</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl" style={`background-image: ${theme.util.gx('cyan', 'purple')}; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;`}>Meet the team.</h1>
    <p class="mt-4 max-w-3xl text-base text-slate-600 dark:text-slate-300 sm:text-lg">
      Our Hack Club is run by passionate students who believe in learning by doing.
      From organizing bootcamps to leading workshops, every team member plays a vital role in making our community thrive.
    </p>
    <p class="mt-3 max-w-3xl text-base text-slate-600 dark:text-slate-300 sm:text-lg">
      This is the {currentSeason.label} team. Past seasons are kept below, because they are part of the record too.
    </p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a class="btn cta justify-center sm:justify-start" href="#all-members">Meet the current team</a>
      <a
        class="btn outline justify-center sm:justify-start"
        href={archivedSeasons[0] ? `#season-${archivedSeasons[0].number}-members` : '#all-members'}
      >
        See former leaders
      </a>
    </div>
  </section>

  <!-- Team Introduction -->
  <section class="mb-12">
    <h2 class="mb-6 text-3xl font-bold text-slate-900 dark:text-white">Who We Are</h2>
    <div class="card">
      <p class="text-lg text-slate-600 dark:text-slate-300">
        We're a diverse group of students united by our love for technology and making. 
        Each member brings unique skills — from coding and design to event planning and community management — 
        creating a well-rounded team that can tackle any challenge.
      </p>
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
        <div class="rounded-xl bg-slate-100 p-4 dark:bg-slate-800">
          <p class="text-2xl font-bold text-slate-900 dark:text-white">{team.length}</p>
          <p class="text-sm text-slate-600 dark:text-slate-400">Active Members</p>
        </div>
        <div class="rounded-xl bg-slate-100 p-4 dark:bg-slate-800">
          <p class="text-2xl font-bold text-slate-900 dark:text-white">4</p>
          <p class="text-sm text-slate-600 dark:text-slate-400">Bootcamp Tracks</p>
        </div>
        <div class="rounded-xl bg-slate-100 p-4 dark:bg-slate-800">
          <p class="text-2xl font-bold text-slate-900 dark:text-white">100%</p>
          <p class="text-sm text-slate-600 dark:text-slate-400">Student-Led</p>
        </div>
      </div>
    </div>
  </section>

  {showLeaderApplications && (
    <section class="mb-12">
      <div class="card gradient-red-orange">
        <p class="text-sm font-semibold uppercase tracking-wide text-[var(--red)]">// WE'RE HIRING LEADERS</p>
        <h2 class="mt-3 text-3xl font-bold text-slate-900 dark:text-white">Help shape the next season of the club.</h2>
        <p class="mt-4 max-w-3xl text-lg text-slate-600 dark:text-slate-300">
          We are looking for new leaders who can run workshops, coordinate events, and keep the club growing. If you want to apply, start with the form and show us how you would contribute.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn cta" href="/be-leader">Apply to be a leader</a>
          <a class="btn outline" href="https://polygon.hackclub.com/club.html" target="_blank" rel="noreferrer">Learn about Polygon</a>
        </div>
      </div>
    </section>
  )}

  <!-- Current Team Grid -->
  <section class="mb-12" id="all-members">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">
          {currentSeason.label} · {currentSeason.years}
        </p>
        <h2 class="mt-2 text-3xl font-bold text-slate-900 dark:text-white">{currentSeason.label} leaders</h2>
      </div>
      <span class="pill">{team.length} active members</span>
    </div>
    <TeamGrid team={team} />
  </section>

  <!-- Former leaders, grouped by the season they ran -->
  {
    archivedSeasons.map((season) => {
      const members = bySeason(allMembers, season.number);
      return members.length > 0 ? (
        <section class="mb-12" id={`season-${season.number}-members`}>
          <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">
                // {season.years} · ARCHIVED
              </p>
              <h2 class="mt-2 text-3xl font-bold text-slate-900 dark:text-white">{season.label} leaders</h2>
              <p class="mt-2 max-w-3xl text-slate-600 dark:text-slate-300">
                These members led {season.label}. Their cards stay here because the work they did is still part of the
                club's record.
              </p>
            </div>
            <a
              href={`/${season.slug}`}
              class="btn outline shrink-0"
            >
              Read the {season.label} archive →
            </a>
          </div>
          <TeamGrid team={members} variant="former" />
        </section>
      ) : null;
    })
  }

  <!-- Anything from a season with no dedicated page -->
  {
    ungrouped.length > 0 && (
      <section class="mb-12">
        <div class="mb-6">
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white">Other former members</h2>
        </div>
        <TeamGrid team={ungrouped} variant="former" />
      </section>
    )
  }

  <!-- Join the Team CTA -->
  <section class="mb-12">
    <div class="card gradient-cyan-purple">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Want to join the team?</h2>
      <p class="mt-3 text-slate-600 dark:text-slate-300">
        We're always looking for passionate students who want to contribute to the club's growth. 
        Whether you're interested in organizing events, mentoring peers, or leading a bootcamp track, 
        there's a place for you on our team.
      </p>
      <div class="mt-6">
        <a class="btn outline" href="/contact">Express your interest</a>
      </div>
    </div>
  </section>

  <!-- What Members Say (Testimonials) -->
  <section class="mb-12">
    <h2 class="mb-6 text-3xl font-bold text-slate-900 dark:text-white">What Our Members Say</h2>
    <div class="grid gap-6 md:grid-cols-2">
      <div class="card">
        <p class="text-sm italic text-slate-600 dark:text-slate-300">
          "Being part of the Hack Club team has been one of the most rewarding experiences. 
          Leading bootcamps and seeing members grow their skills is incredibly fulfilling."
        </p>
        <p class="mt-4 text-sm font-semibold text-slate-900 dark:text-white">— Team Member</p>
      </div>
      <div class="card">
        <p class="text-sm italic text-slate-600 dark:text-slate-300">
          "This club gave me the confidence to ship real projects. The collaborative environment 
          and peer support made learning fun and effective."
        </p>
        <p class="mt-4 text-sm font-semibold text-slate-900 dark:text-white">— Bootcamp Participant</p>
      </div>
    </div>
  </section>

  <!-- Get in Touch -->
  <section>
    <div class="card text-center">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Have questions about the team?</h2>
      <p class="mt-3 text-slate-600 dark:text-slate-300">
        Want to learn more about our roles, responsibilities, or how we organize? 
        Feel free to reach out — we're always happy to chat!
      </p>
      <div class="mt-6">
        <a class="btn cta" href="/contact">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>

