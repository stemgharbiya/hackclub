---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JoinTeamForm from './_JoinTeamForm.tsx';
import { ACADEMIC_TRACK_OPTIONS, COMMITTEE_OPTIONS } from './_questions';
import theme from '@hackclub/theme';

const committeeBadges = COMMITTEE_OPTIONS.filter((committee) => committee !== 'Academics');

const steps = [
  {
    title: 'Tell us about you',
    body: 'Your name, email, phone number, and the committee you want to join. Pick Academics to choose a track.'
  },
  {
    title: 'Answer your committee questions',
    body: 'Step 2 only shows the questions written for your selection, so you never answer anything irrelevant.'
  },
  {
    title: 'We review and follow up',
    body: 'Applications are stored with the status New, then read by the committee heads who will contact you.'
  }
];

const expectations = [
  {
    title: 'Answers, not essays',
    body: 'Most people finish in about five minutes. Short and specific beats long and polished.'
  },
  {
    title: 'Only optional fields can be blank',
    body: 'Every question is required. The links marked Optional can be left empty if you have nothing to share yet.'
  },
  {
    title: 'One application is enough',
    body: 'Apply to the committee that fits you best. You can always reach out later if your interests change.'
  }
];
---

<BaseLayout
  title="Join the team | Gharbiya STEM Hack Club"
  description="Apply to join a Gharbiya STEM Hack Club committee or academics track."
  currentPath="/join-team"
>
  <!-- Hero -->
  <section class="card mb-12 overflow-hidden gradient-red-orange">
    <p class="text-sm font-semibold uppercase tracking-wide text-[var(--red)]">// JOIN THE TEAM</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl" style={`background-image: ${theme.util.gx('orange', 'red')}; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;`}>
      Find your place in the club.
    </h1>
    <p class="mt-4 max-w-3xl text-base text-slate-600 dark:text-slate-300 sm:text-lg">
      Six committees, four academics tracks, one application. Pick what you want to build, answer a short set of
      questions written by the people who run it, and we will take it from there.
    </p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a class="btn cta justify-center sm:justify-start" href="#application-form">Start the application</a>
      <a class="btn outline justify-center sm:justify-start" href="#committees">See committees</a>
    </div>
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
      <div class="rounded-xl border border-slate-200 p-3 sm:p-4 dark:border-slate-800">
        <p class="text-2xl font-bold text-slate-900 dark:text-white">6</p>
        <p class="mt-1 text-xs text-slate-600 dark:text-slate-300 sm:text-sm">Committees</p>
      </div>
      <div class="rounded-xl border border-slate-200 p-3 sm:p-4 dark:border-slate-800">
        <p class="text-2xl font-bold text-slate-900 dark:text-white">4</p>
        <p class="mt-1 text-xs text-slate-600 dark:text-slate-300 sm:text-sm">Academics tracks</p>
      </div>
      <div class="rounded-xl border border-slate-200 p-3 sm:p-4 dark:border-slate-800">
        <p class="text-2xl font-bold text-slate-900 dark:text-white">2</p>
        <p class="mt-1 text-xs text-slate-600 dark:text-slate-300 sm:text-sm">Steps to apply</p>
      </div>
      <div class="rounded-xl border border-slate-200 p-3 sm:p-4 dark:border-slate-800">
        <p class="text-2xl font-bold text-slate-900 dark:text-white">5 min</p>
        <p class="mt-1 text-xs text-slate-600 dark:text-slate-300 sm:text-sm">Average time</p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="mb-12">
    <h2 class="mb-6 text-3xl font-bold text-slate-900 dark:text-white">How applying works</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        steps.map((item, index) => (
          <div class="card">
            <span class="pill">{index + 1}</span>
            <h3 class="mt-3 text-xl font-bold text-slate-900 dark:text-white">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Committees and tracks -->
  <section class="mb-12" id="committees">
    <div class="card gradient-cyan-purple">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">Where you can apply</p>
      <h2 class="mt-2 text-3xl font-bold text-slate-900 dark:text-white">Committees and tracks.</h2>

      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
            Committees
          </h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {committeeBadges.map((committee) => (
              <span class="outline-badge">{committee}</span>
            ))}
          </div>
          <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            Committee members own the parts of the club that keep things running: sponsorships, people, content,
            logistics, and the site.
          </p>
        </div>

        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
            Academics tracks
          </h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {ACADEMIC_TRACK_OPTIONS.map((track) => (
              <span class="outline-badge">{track}</span>
            ))}
          </div>
          <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            Academics members go through the February to June bootcamps and then teach what they learn to the rest of
            the club.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What to expect -->
  <section class="mb-12">
    <h2 class="mb-6 text-3xl font-bold text-slate-900 dark:text-white">What to expect</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        expectations.map((item) => (
          <div class="card">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Application form -->
  <section class="mb-12 scroll-mt-24" id="application-form">
    <div class="mb-6 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-[var(--red)]">// APPLICATION FORM</p>
      <h2 class="mt-3 text-3xl font-bold text-slate-900 dark:text-white sm:text-4xl">
        Tell us how you would contribute.
      </h2>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-300 sm:text-lg">
        Answer honestly and specifically. We are looking for people who take ownership, not for perfect answers.
      </p>
    </div>

    <JoinTeamForm client:load />
  </section>

  <!-- Closing CTA -->
  <section>
    <div class="card overflow-hidden gradient-red-orange text-center">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white sm:text-3xl">Still deciding?</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
        Come to an event first and talk to the committee heads in person. That is the fastest way to find the group you
        would enjoy.
      </p>
      <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a class="btn cta justify-center sm:justify-start" href="/events">See upcoming events</a>
        <a class="btn outline justify-center sm:justify-start" href="/contact">Ask a question</a>
      </div>
    </div>
  </section>
</BaseLayout>
