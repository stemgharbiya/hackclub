---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCards from '../../components/EventCards.astro';
import {
  bySeason,
  getCurrentSeason,
  getShowcaseSeason,
  isShowcaseSeasonArchived
} from '../../lib/seasons';
import theme from '@hackclub/theme';

// Leadership is the current season; events shown come from SHOWCASE_SEASON.
const currentSeason = getCurrentSeason();
const showcaseSeason = getShowcaseSeason();
const showcaseIsArchived = isShowcaseSeasonArchived();

const allEvents = (await getCollection('events')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const events = bySeason(allEvents, showcaseSeason.number);
const archivedCount = allEvents.length - events.length;

const upcomingEvents = events.filter(e => e.data.date > new Date());
const pastEvents = events.filter(e => e.data.date <= new Date());
---

<BaseLayout
  title="Events | Gharbiya STEM Hack Club"
  description="Track season events and outcomes by Gharbiya STEM Hack Club."
  currentPath="/events"
>
  <!-- Hero Section -->
  <section class="card mb-12">
    <p class="text-sm font-semibold uppercase tracking-wide" style="color: var(--color-green)">// ALWAYS BUILDING · {showcaseSeason.label.toUpperCase()}</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl" style={`background-image: ${theme.util.gx('green', 'cyan')}; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;`}>Something's always happening.</h1>
    <p class="mt-4 max-w-3xl text-base text-slate-600 dark:text-slate-300 sm:text-lg">
      From kickoff celebrations to workshop fairs, our events bring the community together to learn,
      build, and share. {showcaseSeason.label} delivered {events.length} event{events.length !== 1 ? 's' : ''} with strong participation and outcomes.
    </p>
    {
      showcaseIsArchived && (
        <p class="mt-3 max-w-3xl text-base text-slate-600 dark:text-slate-300 sm:text-lg">
          {currentSeason.label} is under way now — its events will appear here as soon as they are scheduled.
        </p>
      )
    }
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn cta" href="https://www.instagram.com/gh_hackclub/" target="_blank" rel="noreferrer">Follow for updates</a>
      <a class="btn outline" href="#past-events">View past events</a>
    </div>
  </section>

  <!-- Upcoming Events -->
  {upcomingEvents.length > 0 && (
    <section class="mb-12">
      <h2 class="mb-6 text-3xl font-bold text-slate-900 dark:text-white">Upcoming Events</h2>
      <EventCards events={upcomingEvents} />
    </section>
  )}

  <!-- Past Events Gallery -->
  <section class="mb-12" id="past-events">
    <h2 class="mb-6 text-3xl font-bold text-slate-900 dark:text-white">Past Events</h2>
    <EventCards events={pastEvents} />
    {
      archivedCount > 0 && (
        <div class="card mt-6 flex flex-wrap items-center justify-between gap-4">
          <p class="text-sm text-slate-600 dark:text-slate-300">
            {archivedCount} older event{archivedCount !== 1 ? 's are' : ' is'} kept in past season archives.
          </p>
          <a class="btn outline" href="/seasons">Browse all seasons</a>
        </div>
      )
    }
  </section>

  <!-- Event Stats / Impact -->
  <section class="mb-12">
    <h2 class="mb-6 text-3xl font-bold text-slate-900 dark:text-white">{showcaseSeason.label} impact</h2>
    <div class="grid gap-6 sm:grid-cols-3">
      <div class="card text-center">
        <p class="text-4xl font-bold" style="color: var(--accent)">{events.length}</p>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Events Delivered</p>
      </div>
      <div class="card text-center">
        <p class="text-4xl font-bold" style="color: var(--color-green)">100+</p>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Total Participants</p>
      </div>
      <div class="card text-center">
        <p class="text-4xl font-bold" style="color: var(--color-blue)">Level 3</p>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Achievement Tier</p>
      </div>
    </div>
  </section>

  <!-- Hackathons / Special Events -->
  <section class="mb-12">
    <div class="card">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Planning a Hackathon?</h2>
      <p class="mt-3 text-slate-600 dark:text-slate-300">
        We're always looking to collaborate with other clubs and organizations. Whether you're hosting a hackathon, 
        running a workshop, or organizing a tech event, we'd love to partner up or participate.
      </p>
      <div class="mt-6">
        <a class="btn outline" href="/contact">Get in touch</a>
      </div>
    </div>
  </section>

  <!-- Newsletter / Follow CTA -->
  <section>
    <div class="card text-center gradient-green-cyan">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Never miss an event</h2>
      <p class="mt-3 text-slate-600 dark:text-slate-300">
        Follow us on Instagram to get the latest updates, event announcements, and registration links.
      </p>
      <div class="mt-6">
        <a class="btn cta" href="https://www.instagram.com/gh_hackclub/" target="_blank" rel="noreferrer">
          Follow @gh_hackclub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

