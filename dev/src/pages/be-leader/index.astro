---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import theme from '@hackclub/theme';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const leaders = team.filter((member) => member.data.role.toLowerCase().includes('leader') || member.data.role.toLowerCase().includes('president'));
---

<BaseLayout
  title="Be a leader | Gharbiya STEM Hack Club"
  description="Apply to join the next leadership team for Gharbiya STEM Hack Club."
  currentPath="/be-leader"
>
  <section class="card mb-12 overflow-hidden gradient-red-orange">
    <p class="text-sm font-semibold uppercase tracking-wide text-[var(--red)]">// LEAD THE NEXT SEASON</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl" style={`background-image: ${theme.util.gx('red', 'orange')}; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;`}>
      Help shape the next season.
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-slate-600 dark:text-slate-300">
      We are always looking for people who can run workshops, coordinate events, and keep the club growing. The online
      application is closed right now, but we read every message that comes in and we would still love to hear from you.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a class="btn cta" href="/contact">Get in touch</a>
      <a class="btn outline" href="/join-team">Join the team</a>
    </div>
  </section>

  <section class="mb-12">
    <div class="grid gap-6 lg:grid-cols-3">
      <div class="card">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">What we need</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900 dark:text-white">Leaders who can build, organize, and communicate.</h2>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          We are looking for people who can take ownership, work with a team, and turn good ideas into real club experiences.
        </p>
      </div>
      <div class="card">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">What to tell us</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900 dark:text-white">Your story, your track record, and your plan.</h2>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          Write to us about your background, the Hack Club work you have already done, your plan for the season, and how
          you would lead an event.
        </p>
      </div>
      <div class="card">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">Current team</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900 dark:text-white">{leaders.length} current leaders.</h2>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          We are adding leadership capacity for the next season, so there is room for people who want to strengthen the team.
        </p>
      </div>
    </div>
  </section>

  <section class="mb-12">
    <div class="card gradient-purple-blue">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">What we would ask about</p>
      <h2 class="mt-2 text-2xl font-bold text-slate-900 dark:text-white">Understand the Polygon scenario.</h2>
      <p class="mt-3 max-w-3xl text-slate-600 dark:text-slate-300">
        A question we ask every season is how you would organize a sequencing fulfillment event with a small Polygon grant.
        Read about Polygon first so your plan reflects a real direction.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn outline" href="https://polygon.hackclub.com/club.html" target="_blank" rel="noreferrer">Read more about Polygon</a>
      </div>
    </div>
  </section>

  <section class="mb-12" id="application-form">
    <div class="card">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--accent)]">// APPLICATIONS</p>
      <h2 class="mt-2 text-3xl font-bold text-slate-900 dark:text-white">The online form is closed for now.</h2>
      <p class="mt-3 max-w-3xl text-lg text-slate-600 dark:text-slate-300">
        Our leader application used to run on its own form service, and that service has been switched off. Rather than
        leave you with a form that goes nowhere, we have taken it down. Nothing is lost by messaging us instead — a DM
        reaches the same people, and we answer every one.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn cta" href="/contact">Message us on Instagram</a>
        <a class="btn outline" href="/team">Meet the current team</a>
      </div>
    </div>
  </section>
</BaseLayout>
