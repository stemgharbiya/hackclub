---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  team: CollectionEntry<'team'>[];
  /** Renders muted styling for archived seasons. */
  variant?: 'current' | 'former';
}

const { team, variant = 'current' } = Astro.props as Props;

const isFormer = variant === 'former';

/** Initials fallback for members without a photo yet. */
const initialsOf = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part.charAt(0).toUpperCase())
    .join('');
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {
    team.map(({ data, body }) => (
      <article class:list={['card', isFormer && 'opacity-90']}>
        {data.photo ? (
          <Image
            src={data.photo}
            alt={data.name}
            class="mb-4 h-56 w-full rounded-xl object-cover"
            loading="lazy"
          />
        ) : (
          <div
            class="mb-4 flex h-56 w-full items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800"
            aria-hidden="true"
          >
            <span class="text-4xl font-bold text-slate-600 dark:text-slate-300">
              {initialsOf(data.name)}
            </span>
          </div>
        )}
        <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{data.name}</h3>
        <p class="text-sm font-medium text-blue-600 dark:text-blue-400">{data.role}</p>
        <p class="mt-1 text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
          {data.committee}
        </p>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">{body}</p>
        {(data.github || data.instagram) && (
          <div class="mt-4 flex items-center gap-3">
            {data.github && (
              <a
                href={data.github}
                target="_blank"
                rel="noreferrer"
                class="text-xs font-semibold transition-opacity hover:opacity-80"
                style="color: var(--accent)"
              >
                {data.name} on GitHub
              </a>
            )}
            {data.instagram && (
              <a
                href={data.instagram}
                target="_blank"
                rel="noreferrer"
                class="text-xs font-semibold transition-opacity hover:opacity-80"
                style="color: var(--accent)"
              >
                {data.name} on Instagram
              </a>
            )}
          </div>
        )}
      </article>
    ))
  }
</div>
